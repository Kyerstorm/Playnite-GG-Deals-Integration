<UserControl x:Class="GGDealsWishlist.Views.CollectionsManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:GGDealsWishlist.Views"
             x:Name="Root"
             Foreground="{DynamicResource GG.Text}"
             Background="{DynamicResource GG.Background}"
             Padding="16"
             MinWidth="420" MinHeight="360">
    <UserControl.Resources>
        <v:BoolToVisibilityConverter x:Key="Vis" />
    </UserControl.Resources>
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Wishlist collections" FontSize="17" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource GG.TextMuted}" Margin="0,4,0,12"
                   Text="Collections are local to this extension. They do not change your GG.deals wishlist or your Playnite library." />

        <!-- New collection -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding Icons}" SelectedItem="{Binding NewIcon}" Width="54" Margin="0,0,6,0" ToolTip="Icon" AutomationProperties.Name="Icon" />
            <TextBox Grid.Column="1" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Padding="4" AutomationProperties.Name="New collection name">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="2" Content="Add" Command="{Binding AddCommand}" Padding="14,4" Margin="6,0,0,0" />
        </Grid>
        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorText}" Foreground="{DynamicResource GG.Error}" TextWrapping="Wrap" Margin="0,0,0,6"
                   Visibility="{Binding ErrorText, Converter={StaticResource Vis}}" />

        <Grid>
            <TextBlock Text="No collections yet. Create one above, or right-click a game in the sidebar." TextWrapping="Wrap"
                       Foreground="{DynamicResource GG.TextMuted}" Margin="0,16,0,0" HorizontalAlignment="Center"
                       Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}" />
            <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" HorizontalContentAlignment="Stretch"
                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding DataContext.Icons, ElementName=Root}" SelectedItem="{Binding Icon}" Width="54" Margin="0,0,6,0" />
                            <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="3" VerticalContentAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding CountText}" Foreground="{DynamicResource GG.TextMuted}" VerticalAlignment="Center" Margin="10,0" MinWidth="56" />
                            <Button Grid.Column="3" Content="Save" Padding="10,3" Margin="0,0,4,0"
                                    CommandParameter="{Binding}" Command="{Binding DataContext.SaveCommand, ElementName=Root}" />
                            <Button Grid.Column="4" Content="Delete" Padding="10,3"
                                    CommandParameter="{Binding}" Command="{Binding DataContext.DeleteCommand, ElementName=Root}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</UserControl>
