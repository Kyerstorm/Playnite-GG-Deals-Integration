<UserControl x:Class="GGDealsWishlist.Views.CoverPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:GGDealsWishlist.Views"
             Foreground="{DynamicResource GG.Text}"
             Background="{DynamicResource GG.Background}"
             Padding="16"
             MinWidth="560" MinHeight="420">
    <UserControl.Resources>
        <v:BoolToVisibilityConverter x:Key="Vis" />
    </UserControl.Resources>
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Heading}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource GG.TextMuted}" Margin="0,4,0,12"
                   Text="Click a cover to use it for this game. You can switch back with Change Cover → Reset to automatic." />
        <Button DockPanel.Dock="Bottom" Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Right" Padding="16,4" Margin="0,12,0,0" IsCancel="True" />

        <Grid>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{DynamicResource GG.TextMuted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="360"
                       Visibility="{Binding StatusText, Converter={StaticResource Vis}}" />
            <ListBox ItemsSource="{Binding Candidates}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,10,10" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Width="140" Height="210" Padding="0" Cursor="Hand"
                                Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" ToolTip="Use this cover">
                            <Grid>
                                <Rectangle Fill="{DynamicResource GG.Placeholder}" />
                                <Image v:CoverImage.DecodeWidth="280" v:CoverImage.Source="{Binding ThumbUrl}" Stretch="UniformToFill" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</UserControl>
