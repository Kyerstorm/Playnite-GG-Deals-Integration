<UserControl x:Class="GGDealsWishlist.Views.SetupWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:GGDealsWishlist.Views"
             xmlns:vm="clr-namespace:GGDealsWishlist.ViewModels"
             x:Name="Root"
             Foreground="{DynamicResource GG.Text}"
             Background="{DynamicResource GG.Background}"
             Padding="22,18"
             MinWidth="500" MinHeight="440">
    <UserControl.Resources>
        <v:BoolToVisibilityConverter x:Key="Vis" />
        <v:BoolToVisibilityConverter x:Key="InvVis" Invert="True" />

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GG.TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <!-- Success / error / busy colouring for the inline test results -->
        <Style x:Key="KeyStatus" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource GG.TextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding KeyStatusKind}" Value="Success">
                    <Setter Property="Foreground" Value="{DynamicResource GG.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding KeyStatusKind}" Value="Error">
                    <Setter Property="Foreground" Value="{DynamicResource GG.Error}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding KeyStatusKind}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource GG.Warning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SteamStatus" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource GG.Warning}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SteamStatusIsOk}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource GG.Success}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Navigation -->
        <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button HorizontalAlignment="Left" Content="Cancel" Command="{Binding CancelCommand}" Padding="14,5" MinWidth="84" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ActionButton}" Content="Back" Command="{Binding BackCommand}"
                        Visibility="{Binding CanGoBack, Converter={StaticResource Vis}}" />
                <Button Style="{StaticResource ActionButton}" Content="Skip" Command="{Binding SkipCommand}"
                        Visibility="{Binding CanSkip, Converter={StaticResource Vis}}" />
                <Button Style="{StaticResource ActionButton}" Content="{Binding NextText}" Command="{Binding NextCommand}" IsDefault="True" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="{Binding StepText}" Style="{StaticResource Muted}" FontSize="11.5" />
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,6" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" />
        </StackPanel>

        <Grid>
            <!-- 1. API key -->
            <StackPanel Visibility="{Binding IsKeyStep, Converter={StaticResource Vis}}">
                <TextBlock Style="{StaticResource Label}" Text="API key" />
                <PasswordBox x:Name="KeyBox" PasswordChanged="OnKeyChanged" Padding="5" AutomationProperties.Name="GG.deals API key" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Test connection" Command="{Binding TestKeyCommand}" Padding="14,5" />
                    <Button Content="Where do I get a key?" Command="{Binding OpenApiInfoCommand}" Padding="14,5" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding KeyStatus}" Style="{StaticResource KeyStatus}" Visibility="{Binding KeyStatus, Converter={StaticResource Vis}}" />
            </StackPanel>

            <!-- 2. Region -->
            <StackPanel Visibility="{Binding IsRegionStep, Converter={StaticResource Vis}}">
                <TextBlock Style="{StaticResource Label}" Text="Region" />
                <ComboBox ItemsSource="{Binding RegionOptions}" SelectedItem="{Binding SelectedRegion}" DisplayMemberPath="DisplayName" Padding="5" AutomationProperties.Name="Region" />
            </StackPanel>

            <!-- 3. Wishlist source -->
            <StackPanel Visibility="{Binding IsSourceStep, Converter={StaticResource Vis}}">
                <RadioButton GroupName="Source" Content="My Steam wishlist" IsChecked="{Binding UseSteam}" Foreground="{DynamicResource GG.Text}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <StackPanel Margin="22,0,0,14" Visibility="{Binding UseSteam, Converter={StaticResource Vis}}">
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,6"
                               Text="Enter your SteamID64 (17 digits) or a steamcommunity.com/profiles/… link. Your wishlist must be public." />
                    <TextBox Text="{Binding SteamIdText, UpdateSourceTrigger=PropertyChanged}" Padding="5" AutomationProperties.Name="SteamID64" />
                    <TextBlock Text="{Binding SteamHint}" Foreground="{DynamicResource GG.Error}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding SteamHint, Converter={StaticResource Vis}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Check my wishlist" Command="{Binding CheckSteamCommand}" Padding="14,5" />
                        <Button Content="Steam privacy settings" Command="{Binding OpenSteamPrivacyCommand}" Padding="14,5" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding SteamStatus}" Style="{StaticResource SteamStatus}" Visibility="{Binding HasSteamStatus, Converter={StaticResource Vis}}" />
                </StackPanel>

                <RadioButton GroupName="Source" Content="A manual list of games" IsChecked="{Binding UseManual}" Foreground="{DynamicResource GG.Text}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <StackPanel Margin="22,0,0,0" Visibility="{Binding UseManual, Converter={StaticResource Vis}}">
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,6" Text="One Steam app ID or store link per line." />
                    <TextBox Text="{Binding ManualText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" Height="110" Padding="5" AutomationProperties.Name="Manual game list" />
                </StackPanel>
            </StackPanel>

            <!-- 4. Covers -->
            <StackPanel Visibility="{Binding IsCoversStep, Converter={StaticResource Vis}}">
                <TextBlock Style="{StaticResource Label}" Text="SteamGridDB API key" />
                <TextBox Text="{Binding SteamGridDbKey, UpdateSourceTrigger=PropertyChanged}" Padding="5" AutomationProperties.Name="SteamGridDB API key" />
                <Button Content="Get a free key" Command="{Binding OpenSteamGridDbCommand}" HorizontalAlignment="Left" Padding="14,5" Margin="0,10,0,0" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,14,0,0"
                           Text="You can skip this. It also unlocks Change cover, where you can pick a different image for any game." />
            </StackPanel>

            <!-- Done -->
            <StackPanel Visibility="{Binding IsDoneStep, Converter={StaticResource Vis}}">
                <ItemsControl ItemsSource="{Binding SummaryLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap">
                                <Run Text="✓ " Foreground="{DynamicResource GG.Success}" FontWeight="Bold" /><Run Text="{Binding Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Text="Finish loads your wishlist and prices now." />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
